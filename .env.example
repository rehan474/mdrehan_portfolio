# This project works with ZERO environment variables out of the box —
# the contact form opens the visitor's email client directly.
#
# These are OPTIONAL, for if you later wire up a real backend
# (e.g. Firebase Firestore to store contact form submissions, or a
# real AI assistant instead of the rule-based chat widget).
# Copy this file to `.env` and fill in values, then update
# src/components/Contact.jsx / ChatAssistant.jsx to use them.
# Never commit your real `.env` file — it's already in .gitignore.

# --- Firebase (optional, for storing contact form submissions) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# --- reCAPTCHA (optional, for spam-proofing the contact form) ---
VITE_RECAPTCHA_SITE_KEY=

# --- AI assistant backend (optional) ---
# Only ever call the Anthropic/OpenAI API from a server route you control —
# never put a real API key in a VITE_ variable, since anything prefixed
# VITE_ is bundled into the public JS and visible to anyone.
VITE_CHAT_BACKEND_URL=
